# Copy to .env (local) or store in AWS Secrets Manager / SSM (production). NEVER commit real values.
NODE_ENV=production
PORT=9003
APP_ID=
ST_KEY=
# Fyers redirect = <this>/api/auth/callback
PUBLIC_BACKEND_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
# persistent volume
FYERS_TOKEN_DIR=/data/fyers

DATABASE_URL=postgres://tgg_app:CHANGE_ME@your-rds-endpoint:5432/tgg
PG_SSL=true
PG_SSL_CA_FILE=/etc/ssl/rds/global-bundle.pem
PG_POOL_MAX=20

# Security (server refuses to start in production if these are weak)
# 8+ characters
PIN=
# 32+ random chars: openssl rand -base64 48
ADMIN_SESSION_SECRET=
CORS_ORIGINS=https://app.example.com
# 2 if CloudFront is in front of the ALB
TRUST_PROXY_HOPS=1
RATE_LIMIT_PER_MIN=300


# Storage flags (see database/src/storageFlags.js)
STORE_SPOT=true
STORE_NSE_OPTIONS=false
STORE_BSE_OPTIONS=false
STORE_MCX_OPTIONS=false
STORE_NSE_FUTURES=false
STORE_BSE_FUTURES=false
STORE_MCX_FUTURES=false

# Second Fyers account (Recorder) - 2026-11-05. Account 1 = APP_ID / ST_KEY above (Charts).
# Register PUBLIC_BACKEND_URL/api/auth/callback/2 as the Redirect URL of account 2's Fyers app.
NICKNAME_1=Amruta maam
NICKNAME_2=HItaarth
APP_ID_2=
ST_KEY_2=
# REDIRECT_URI_2=        (only if PUBLIC_BACKEND_URL is not set)

# PaRRVA recommendations API - polled by the backend only (browsers never hit it)
PARRVA_API_URL=https://tgcare.tglevels.com/api/public/recommendations
# trading day 09:00-15:40 IST
PARRVA_POLL_SEC=60
# any other time
PARRVA_IDLE_POLL_SEC=1800
# "Refresh" button: at most one real call per 20 s
PARRVA_MIN_GAP_SEC=20
# recordings, candles, results (default backend/parrva_data). On the server use a persistent volume.
PARRVA_DATA_DIR=/data/parrva
# PARRVA_LIVE=false           # turns the live PaRRVA service + recorder off

# Recorder (runs on Fyers account 2 in its own process)
# start/stop automatically on trading days
RECORDER_AUTO=true
RECORDER_START=09:14
RECORDER_STOP=15:42
# 50-level depth: future + ATM pair + the 2 newest open PaRRVA calls
RECORDER_TBT=true
