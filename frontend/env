# Copy to .env (local) or store in AWS Secrets Manager / SSM (production). NEVER commit real values.
NODE_ENV=production
PORT=9003
APP_ID=
ST_KEY=
PUBLIC_BACKEND_URL=https://app.example.com       # Fyers redirect = <this>/api/auth/callback
FRONTEND_URL=https://app.example.com
FYERS_TOKEN_DIR=/data/fyers                      # persistent volume

DATABASE_URL=postgres://tgg_app:CHANGE_ME@your-rds-endpoint:5432/tgg
PG_SSL=true
PG_SSL_CA_FILE=/etc/ssl/rds/global-bundle.pem
PG_POOL_MAX=20

# Security (server refuses to start in production if these are weak)
# Admin accounts (recommended). One entry per admin, comma-separated, format  username:scrypt$salt$hash
# Create each entry with:   node backend/src/scripts/hashPassword.js
ADMIN_USERS=
# Legacy single PIN - only used when ADMIN_USERS is empty (8+ characters)
PIN=
# REQUIRED. 32+ random chars, signs login tokens:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MIN=480
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1        # 2 if CloudFront is in front of the ALB
RATE_LIMIT_PER_MIN=300

KRONOS_SERVICE_URL=http://kronos.internal:8001

# Storage flags (see database/src/storageFlags.js)
STORE_SPOT=true
STORE_NSE_OPTIONS=false
STORE_BSE_OPTIONS=false
STORE_MCX_OPTIONS=false
STORE_NSE_FUTURES=false
STORE_BSE_FUTURES=false
STORE_MCX_FUTURES=false
